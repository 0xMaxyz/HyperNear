[
  { "name": "far from liquidation, healthy margin",
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": 95000, "marginRatio": 4, "annualVol": 0.6 },
    "expect": { "trigger": false, "reasons": [] } },
  { "name": "margin ratio under the 2x floor",
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": 95000, "marginRatio": 1.9, "annualVol": 0.6 },
    "expect": { "trigger": true, "reasons": ["margin_floor"] } },
  { "name": "margin ratio exactly at the floor triggers",
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": 95000, "marginRatio": 2, "annualVol": 0.6 },
    "expect": { "trigger": true, "reasons": ["margin_floor"] } },
  { "name": "liquidation 0.1% away is inside the plausible move (0.18%)",
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": 99900, "marginRatio": 3, "annualVol": 0.6 },
    "expect": { "trigger": true, "reasons": ["latency_move"] } },
  { "name": "extreme volatility widens the plausible move to 1.8%",
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": 99000, "marginRatio": 5, "annualVol": 6.0 },
    "expect": { "trigger": true, "reasons": ["latency_move"] } },
  { "name": "0.2% away, default k=2: not yet",
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": 99800, "marginRatio": 5, "annualVol": 0.6 },
    "expect": { "trigger": false, "reasons": [] } },
  { "name": "0.2% away, k=4 widens the horizon: triggers",
    "cfg": { "k": 4 },
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": 99800, "marginRatio": 5, "annualVol": 0.6 },
    "expect": { "trigger": true, "reasons": ["latency_move"] } },
  { "name": "0.17% away triggers with the 15.8 s end-to-end latency",
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": 99830, "marginRatio": 5, "annualVol": 0.6 },
    "expect": { "trigger": true, "reasons": ["latency_move"] } },
  { "name": "0.17% away is fine with the 12.8 s NEAR-side latency",
    "cfg": { "latencyP95Sec": 12.8 },
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": 99830, "marginRatio": 5, "annualVol": 0.6 },
    "expect": { "trigger": false, "reasons": [] } },
  { "name": "no liquidation price: only the margin floor can fire",
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": null, "marginRatio": 1.5, "annualVol": 0.6 },
    "expect": { "trigger": true, "reasons": ["margin_floor"] } },
  { "name": "no liquidation price and healthy margin",
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": null, "marginRatio": 3, "annualVol": 0.6 },
    "expect": { "trigger": false, "reasons": [] } },
  { "name": "both rules fire",
    "leg": { "id": "a", "markPx": 100000, "liquidationPx": 99900, "marginRatio": 1.5, "annualVol": 0.6 },
    "expect": { "trigger": true, "reasons": ["margin_floor", "latency_move"] } },
  { "name": "short leg: liquidation price above the mark",
    "leg": { "id": "b", "markPx": 100000, "liquidationPx": 100100, "marginRatio": 3, "annualVol": 0.6 },
    "expect": { "trigger": true, "reasons": ["latency_move"] } }
]
