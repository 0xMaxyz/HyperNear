{
  "name": "@perps-platform/core",
  "version": "0.1.0",
  "description": "Hyperliquid client core (stripped PerpX baseline)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "0.33.1",
    "viem": "2.54.3"
  },
  "devDependencies": {
    "@msgpack/msgpack": "3.1.3"
  }
}
