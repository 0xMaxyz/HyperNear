# Copy to .env (gitignored) and fill in. Never commit values.
# Lab wallets (dripped HL testnet accounts). Only indices 1-10 are used by validation/.
LAB_WALLETS_PATH=
LAB_WALLET_INDICES=1-10
# NEAR testnet
NEAR_NETWORK=
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
NEAR_CONTRACT_ID=
NEAR_RPC_URL=
# Agent service (relayer pays gas and storage deposits; agent key is a function-call key)
HYPERNEAR_RELAYER_ACCOUNT_ID=
HYPERNEAR_RELAYER_PRIVATE_KEY=
HYPERNEAR_AGENT_ACCOUNT_ID=
HYPERNEAR_AGENT_PRIVATE_KEY=
# Jev (TypeSafe AI) decision layer
JEV_API_KEY=
TYPESAFE_API_KEY=
# Escalation model
ANTHROPIC_API_KEY=
# Web login
PRIVY_APP_ID=
VITE_PRIVY_APP_ID=
# NEAR AI Cloud chat (upside)
NEAR_AI_API_KEY=

